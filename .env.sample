# Application Configuration
APP_ENV=LOCAL
APP_HOST=127.0.0.1
APP_PORT=8080

# Database Configuration
SQLALCHEMY_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/rysknode_logicmodel
# Set to NullPool for Celery workers to prevent forked-process DB pool corruption
# DB_CONNECTION_POOL_CLASS=NullPool

# Data.gov.in Sync Settings
DATA_GOV_API_KEY=your_api_key_here
DATA_GOV_RESOURCE_ID=4dbe5667-7b6b-41d7-82af-211562424d9a
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
DATA_GOV_RATE_LIMIT_COOLDOWN=120
DATA_GOV_API_LIMIT=10

# Celery / Redis Broker
CELERY_BROKER_URL=redis://:default@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:default@localhost:6379/1
CELERY_CONFIG_MODULE=asyncworker.settings.celeryconfig

# Celery Worker (Orchestrated in src/__main__.py)
ENABLE_CELERY_WORKER=true
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_QUEUES=default,buyer_risk,credit_limit,sync
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TIMEZONE=Asia/Kolkata

# Flower UI (Orchestrated in src/__main__.py)
ENABLE_CELERY_FLOWER=true
CELERY_FLOWER_PORT=5555
CELERY_FLOWER_USER=admin
CELERY_FLOWER_PASSWORD=flowerpass

# Celery Beat Periodic Scheduler
ENABLE_CELERY_BEAT=false
ENABLE_CELERY_BEAT_SYNC=false
CELERY_BEAT_SYNC_CRON_HOUR=2
CELERY_BEAT_SYNC_CRON_MINUTE=0
CELERY_BEAT_SYNC_STATECODE=

# Event Publishing (Redis Pub/Sub)
# Channel pattern: <app_name>-events:<event_name>
CELERY_EVENT_APP_NAME=rysknode
