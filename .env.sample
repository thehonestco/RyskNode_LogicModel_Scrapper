# ==============================================================================
# Application Configuration
# ==============================================================================
# Runtime environment: LOCAL, DEV, STAGING, or PROD (controls uvicorn reload, etc.)
APP_ENV=LOCAL
# Host and port for the FastAPI HTTP server
APP_HOST=127.0.0.1
APP_PORT=8080
# Set to false to run only background Celery workers/Flower without starting FastAPI
ENABLE_API_SERVER=true

# ==============================================================================
# Database Configuration (PostgreSQL + Async SQLAlchemy)
# ==============================================================================
SQLALCHEMY_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/rysknode_logicmodel
# Optional: set to NullPool if sharing engines across forked processes
# DB_CONNECTION_POOL_CLASS=NullPool

# ==============================================================================
# Data.gov.in RoC Synchronization Settings
# ==============================================================================
DATA_GOV_API_KEY=your_api_key_here
DATA_GOV_RESOURCE_ID=4dbe5667-7b6b-41d7-82af-211562424d9a
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
# Cooldown in seconds when data.gov.in returns HTTP 429 rate limits
DATA_GOV_RATE_LIMIT_COOLDOWN=120
# Records fetched per paginated API request (max 1000)
DATA_GOV_API_LIMIT=10

# ==============================================================================
# Celery / Redis Broker & Result Backend
# ==============================================================================
# Redis URL for task queues, result backend, and Pub/Sub events (DB 0)
CELERY_BROKER_URL=redis://:default@localhost:6379/0
# Python module path for Celery configuration
CELERY_CONFIG_MODULE=asyncworker.settings.celeryconfig
# Redis visibility timeout (seconds); should exceed CELERY_TASK_TIME_LIMIT
# CELERY_VISIBILITY_TIMEOUT=3600
# Result TTL in Redis (seconds, default 86400 = 24 hours)
# CELERY_RESULT_EXPIRES=86400

# ==============================================================================
# Celery Workers (Orchestrated in src/__main__.py)
# Each enabled queue launches its own dedicated worker process (-n <queue>@%h)
# with its own independent concurrency (-c).
# ==============================================================================
# Master switch to enable/disable all Celery worker processes
ENABLE_CELERY_WORKER=true

# --- Default / Fallback Queue ---
ENABLE_QUEUE_DEFAULT=true
CELERY_QUEUE_DEFAULT=default
CELERY_CONCURRENCY_DEFAULT=1

# --- S1 Buyer Risk Assessment Queue (asyncworker.tasks.assess_buyer_task) ---
ENABLE_QUEUE_BUYER_RISK=true
CELERY_QUEUE_BUYER_RISK=buyer_risk
CELERY_CONCURRENCY_BUYER_RISK=4

# --- S2 Credit Limit Assessment Queue (asyncworker.tasks.assess_credit_limit_task) ---
ENABLE_QUEUE_CREDIT_LIMIT=true
CELERY_QUEUE_CREDIT_LIMIT=credit_limit
CELERY_CONCURRENCY_CREDIT_LIMIT=2

# --- S4 Vendor Due Diligence Queue (asyncworker.tasks.vendor_due_diligence_task) ---
ENABLE_QUEUE_VDD=true
CELERY_QUEUE_VDD=vendor_due_diligence
CELERY_CONCURRENCY_VDD=2

# Hard SIGKILL limit (seconds) and soft SoftTimeLimitExceeded limit (seconds) per task
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
# Timezone for Celery Beat schedules and task timestamps
CELERY_TIMEZONE=Asia/Kolkata

# ==============================================================================
# Flower Monitoring UI (Orchestrated in src/__main__.py)
# ==============================================================================
ENABLE_CELERY_FLOWER=true
CELERY_FLOWER_PORT=5555
CELERY_FLOWER_USER=admin
CELERY_FLOWER_PASSWORD=flowerpass

# ==============================================================================
# Redis Pub/Sub Event Broadcasting
# Channel pattern: <CELERY_EVENT_APP_NAME>-events:<task_suffix>.<completed|failed|retrying>
# ==============================================================================
# Set to false to disable publishing task lifecycle events to Redis Pub/Sub
ENABLE_CELERY_EVENTS=true
CELERY_EVENT_APP_NAME=rysknode
